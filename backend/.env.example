# Copy to .env and fill in. Never commit .env.

# Signs the admin JWT. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# bcrypt hash of the admin password. Generate one with:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Local dev: SQLite file, relative to backend/
DATABASE_URL=sqlite:///./blog.db
# Supabase (or any Postgres): use "postgresql+psycopg://" so SQLAlchemy picks
# the psycopg3 driver. On Supabase, use the *Session pooler* connection string
# (Project Settings > Database > Connection string), not the direct connection
# — the direct host is IPv6-only and unreachable from Render.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
