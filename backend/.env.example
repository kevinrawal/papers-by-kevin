# Copy to .env and fill in. Never commit .env.

# Signs the admin JWT. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# bcrypt hash of the admin password. Generate one with:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Local dev: SQLite file, relative to backend/
DATABASE_URL=sqlite:///./blog.db
# Render (or any Postgres): use the connection string Render gives you, but
# change its "postgresql://" prefix to "postgresql+psycopg://" so SQLAlchemy
# picks the psycopg3 driver, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
